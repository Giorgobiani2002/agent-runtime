# Prefer GEMINI_API_KEY (Google AI Studio key). Vertex is a fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# Vertex AI project. Railway also needs GCP_SERVICE_ACCOUNT_JSON when no API key is set.
GCP_PROJECT_ID=gen-lang-client-0355771224
GCP_LOCATION=global
GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional: Use Anthropic Claude instead of Gemini
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Backend URL (where to fetch task context from)
BACKEND_URL=http://localhost:3001

# Vertex model used by the browser agent.
AGENT_MODEL=gemini-3.1-flash-lite-preview

# Set true to run headless (no visible browser window) e.g. on Railway
AGENT_HEADLESS=false

# Max steps the agent can take before stopping
AGENT_MAX_STEPS=50
