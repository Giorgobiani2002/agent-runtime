# Required: LLM API key (used by browser-use agent)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Use Anthropic Claude instead of Gemini
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Backend URL (where to fetch task context from)
BACKEND_URL=http://localhost:3001

# LLM model to use (Gemini default)
AGENT_MODEL=gemini-2.5-flash

# Set true to run headless (no visible browser window) e.g. on Railway
AGENT_HEADLESS=false

# Max steps the agent can take before stopping
AGENT_MAX_STEPS=50
